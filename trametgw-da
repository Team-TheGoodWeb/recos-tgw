<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[CLIENT] · Recommandation plan média · The Good Web</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  /* ── Charte The Good Web (kit média 2026) ─────────────── */
  --navy:#0A1B4F;          /* navy profond */
  --royal:#5271FF;         /* bleu roi (couleur signature) */
  --sky:#85B8F8;           /* bleu clair */
  --orange:#F0532D;        /* orange TGW */
  --bg:#FFFFFF;
  --bg-soft:#F6F8FE;
  --surface:#FFFFFF;
  --ink:#0A1B4F;
  --ink-soft:#54608A;
  --accent:var(--orange);
  --line:#E3E8F6;

  /* ── Familles de couleurs (cards, tags, planning) ─────── */
  --lavande-bg:#E9EDFF; --lavande-bd:#BFCBFF; --lavande-tx:#2338B8; --lavande-full:#5271FF;
  --rose-bg:#E4E9FF;    --rose-bd:#A9B6F7;    --rose-tx:#1B2C8F;    --rose-full:#3B55E6;
  --peche-bg:#FEF0E7;   --peche-bd:#F8CFAF;   --peche-tx:#9A4E12;   --peche-full:#F59B4B;
  --menthe-bg:#E8EBF4;  --menthe-bd:#B7C0DA;  --menthe-tx:#0A1B4F;  --menthe-full:#0A1B4F;
  --bleu-bg:#EAF4FE;    --bleu-bd:#A9CFF9;    --bleu-tx:#1D4E9E;    --bleu-full:#4D9BF5;
  --corail-bg:#FDE9E3;  --corail-bd:#F6BFAC;  --corail-tx:#B33917;  --corail-full:#F0532D;
  --sable-bg:#F2F4FA;   --sable-tx:#54608A;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);color:var(--ink);
  font-family:'Inter',system-ui,sans-serif;
  font-size:15px;line-height:1.55;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,.display{font-family:'Poppins',sans-serif}
.wrap{max-width:1080px;margin:0 auto;padding:0 32px}

/* ── Navigation d'ancres ─────────────────────────────── */
nav.toc{
  position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);
  backdrop-filter:blur(8px);border-bottom:1px solid var(--line);
}
nav.toc .wrap{display:flex;gap:4px;overflow-x:auto;padding:10px 32px}
nav.toc a{
  white-space:nowrap;text-decoration:none;color:var(--ink-soft);
  font-size:12.5px;font-weight:600;padding:6px 12px;border-radius:99px;
}
nav.toc a:hover,nav.toc a:focus-visible{background:var(--royal);color:#fff;outline:none}

/* ── Logo The Good Web ───────────────────────────────── */
.tgw-logo{display:flex;flex-direction:column;gap:2px;margin-bottom:34px}
.tgw-logo .rows{font-family:'Poppins';font-weight:800;font-size:26px;line-height:.95;letter-spacing:.01em;color:#fff;text-transform:uppercase}
.tgw-logo .rows .r1{display:flex;align-items:flex-start;gap:8px}
.tgw-logo svg{height:20px;width:auto;margin-top:1px}
.tgw-logo .baseline{font-size:9.5px;font-weight:600;letter-spacing:.12em;color:#DCE6FF;text-transform:uppercase;margin-top:7px}

/* ── Header ──────────────────────────────────────────── */
header.hero{background:var(--royal);color:#fff;padding:52px 0 48px}
.eyebrow{
  display:inline-block;font-size:11.5px;font-weight:700;letter-spacing:.14em;
  text-transform:uppercase;color:#FFD9CC;margin-bottom:18px;
}
header.hero h1{font-size:clamp(30px,4.6vw,44px);font-weight:800;letter-spacing:-.01em;line-height:1.12;max-width:22ch;color:#fff}
header.hero p.sub{color:#E2E9FF;margin-top:16px;max-width:66ch;font-size:15.5px}
.hero-meta{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.hero-meta .pill{
  background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.32);border-radius:12px;
  padding:12px 18px;min-width:150px;
}
.hero-meta .pill small{display:block;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#C7D4FF;margin-bottom:3px}
.hero-meta .pill b{font-family:'Poppins';font-size:16px;font-weight:700;color:#fff}

/* ── Sections ────────────────────────────────────────── */
section{padding:52px 0;border-bottom:1px solid var(--line)}
section:nth-of-type(even){background:var(--bg-soft)}
section:last-of-type{border-bottom:none}
section>.wrap>h2{font-size:21px;font-weight:700;letter-spacing:-.01em;margin-bottom:26px;color:var(--navy)}
section>.wrap>h2::before{content:"↘";color:var(--orange);font-weight:700;margin-right:10px}
.section-intro{color:var(--ink-soft);max-width:70ch;margin:-14px 0 26px}

/* ── Cards objectifs ─────────────────────────────────── */
.obj-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.obj-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px}
.obj-card .num{font-family:'Poppins';font-size:13px;font-weight:800;color:var(--orange);margin-bottom:8px}
.obj-card h3{font-size:15.5px;font-weight:700;margin-bottom:6px}
.obj-card p{font-size:13.5px;color:var(--ink-soft)}

/* ── Phases / temps forts ────────────────────────────── */
.phase-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}
.phase-card{border-radius:14px;padding:18px 20px;border:1px solid}
.phase-card small{display:block;font-size:12px;font-weight:700;margin-bottom:6px}
.phase-card h3{font-size:16px;font-weight:700;margin-bottom:4px;color:var(--ink)}
.phase-card p{font-size:13px}
.c-bleu.phase-card{background:var(--bleu-bg);border-color:var(--bleu-bd)}      .c-bleu small,.c-bleu p{color:var(--bleu-tx)}
.c-menthe.phase-card{background:var(--menthe-bg);border-color:var(--menthe-bd)}.c-menthe small,.c-menthe p{color:var(--menthe-tx)}
.c-peche.phase-card{background:var(--peche-bg);border-color:var(--peche-bd)}   .c-peche small,.c-peche p{color:var(--peche-tx)}
.c-corail.phase-card{background:var(--corail-bg);border-color:var(--corail-bd)}.c-corail small,.c-corail p{color:var(--corail-tx)}
.c-rose.phase-card{background:var(--rose-bg);border-color:var(--rose-bd)}      .c-rose small,.c-rose p{color:var(--rose-tx)}
.c-lavande.phase-card{background:var(--lavande-bg);border-color:var(--lavande-bd)}.c-lavande small,.c-lavande p{color:var(--lavande-tx)}

/* ── Leviers ─────────────────────────────────────────── */
.lever-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}
.lever-card{border-radius:16px;padding:22px;border:1px solid}
.lever-card .ico{font-size:22px;margin-bottom:10px;display:block}
.lever-card h3{font-size:16.5px;font-weight:700;margin-bottom:10px}
.lever-card .tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
.tag{font-size:11.5px;font-weight:600;padding:3px 10px;border-radius:99px}
.lever-card p{font-size:13.5px;color:var(--ink);opacity:.85}
.lever-card.c-lavande{background:var(--lavande-bg);border-color:var(--lavande-bd)}
.lever-card.c-rose{background:var(--rose-bg);border-color:var(--rose-bd)}
.lever-card.c-peche{background:var(--peche-bg);border-color:var(--peche-bd)}
.lever-card.c-menthe{background:var(--menthe-bg);border-color:var(--menthe-bd)}
.lever-card.c-bleu{background:var(--bleu-bg);border-color:var(--bleu-bd)}
.lever-card.c-corail{background:var(--corail-bg);border-color:var(--corail-bd)}
.tag.t-lavande{background:#D3DBFF;color:var(--lavande-tx)}
.tag.t-rose{background:#CBD4FB;color:var(--rose-tx)}
.tag.t-peche{background:#FBDDBB;color:var(--peche-tx)}
.tag.t-menthe{background:#D2D9EA;color:var(--menthe-tx)}
.tag.t-bleu{background:#CBE3FC;color:var(--bleu-tx)}
.tag.t-corail{background:#FAD2C4;color:var(--corail-tx)}
.tag.t-sable{background:#E4E8F3;color:var(--sable-tx)}

/* ── Planning d'activation ───────────────────────────── */
.planning{overflow-x:auto}
.planning table{border-collapse:separate;border-spacing:6px;min-width:760px;width:100%}
.planning th{font-size:12px;font-weight:600;color:var(--ink-soft);text-align:center;padding:4px 6px}
.planning th b{display:block;color:var(--ink);font-weight:700;font-size:12.5px}
.planning td.levier{font-size:13.5px;font-weight:600;white-space:nowrap;padding-right:10px;text-align:left}
.planning td.levier span{margin-right:8px}
.planning td.cell{border-radius:8px;text-align:center;font-size:12px;font-weight:600;padding:9px 8px;min-width:120px}
.cell.off{background:var(--sable-bg);color:transparent}
.cell.pic{color:#fff !important}
.cell.l1{background:var(--lavande-bg);color:var(--lavande-tx)} .cell.l2{background:#B9C6FF;color:#1B2C8F} .cell.l3.pic{background:#3247C8}
.cell.r1{background:var(--rose-bg);color:var(--rose-tx)}       .cell.r2{background:#9FAFF5;color:#141F66}  .cell.r3.pic{background:#1B2C8F}
.cell.p1{background:var(--peche-bg);color:var(--peche-tx)}     .cell.p2{background:#F8C388;color:#7A3D0C}  .cell.p3.pic{background:#D97A1C}
.cell.m1{background:var(--menthe-bg);color:var(--menthe-tx)}   .cell.m2{background:#9FADD1;color:#0A1B4F}  .cell.m3.pic{background:#0A1B4F}
.cell.o1{background:var(--corail-bg);color:var(--corail-tx)}   .cell.o2{background:#F5A088;color:#8A2A10}  .cell.o3.pic{background:#D8431F}
.cell.k1{background:var(--bleu-bg);color:var(--bleu-tx)}       .cell.k2{background:#8FC2F8;color:#123C7E}  .cell.k3.pic{background:#1D5FB8}

/* ── Scénarios budgétaires ───────────────────────────── */
.scen-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-bottom:22px}
.scen-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px}
.scen-card.reco{border-color:var(--orange);box-shadow:0 0 0 1px var(--orange)}
.scen-card small{display:block;font-size:12.5px;font-weight:600;color:var(--ink-soft);margin-bottom:8px}
.scen-card .range{font-family:'Poppins';font-size:28px;font-weight:800;letter-spacing:-.02em;color:var(--navy)}
.scen-card.reco .range{color:var(--orange)}
.scen-card p{font-size:12.5px;color:var(--ink-soft);margin-top:8px}
.note{
  background:var(--sable-bg);border-left:3px solid var(--orange);border-radius:0 10px 10px 0;
  padding:14px 18px;font-size:13.5px;color:var(--ink);margin-bottom:26px;
}
.scen-tabs{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.scen-tabs button{
  font-family:'Inter';font-size:13px;font-weight:600;color:var(--ink-soft);
  background:var(--surface);border:1px solid var(--line);border-radius:99px;
  padding:8px 18px;cursor:pointer;
}
.scen-tabs button[aria-selected="true"]{background:var(--navy);border-color:var(--navy);color:#fff}
.scen-tabs button:focus-visible{outline:2px solid var(--royal);outline-offset:2px}
.budget-table{width:100%;border-collapse:collapse;background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.budget-table th{font-size:11.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#fff;text-align:left;padding:12px 16px;border-bottom:1px solid var(--line);background:var(--navy)}
.budget-table td{padding:12px 16px;border-bottom:1px solid var(--line);font-size:13.5px;vertical-align:middle}
.budget-table tr:last-child td{border-bottom:none}
.budget-table td.lev{font-weight:600}
.budget-table td.num{font-variant-numeric:tabular-nums}
.bar{height:8px;border-radius:99px;background:var(--sable-bg);min-width:120px;overflow:hidden}
.bar i{display:block;height:100%;border-radius:99px}
.bar .f-lavande{background:var(--lavande-full)} .bar .f-rose{background:var(--rose-full)}
.bar .f-peche{background:var(--peche-full)}     .bar .f-menthe{background:var(--menthe-full)}
.bar .f-bleu{background:var(--bleu-full)}       .bar .f-corail{background:var(--corail-full)}
.budget-table tfoot td{background:var(--bg-soft);font-weight:700}
.scen-panel{display:none}
.scen-panel.active{display:block}

/* ── KPIs ────────────────────────────────────────────── */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.kpi-card{background:var(--sable-bg);border-radius:12px;padding:16px 18px}
.kpi-card small{display:block;font-size:12px;font-weight:600;color:var(--sable-tx);margin-bottom:5px}
.kpi-card b{font-size:14px;font-weight:700;line-height:1.35;display:block;color:var(--navy)}

/* ── Segments audiences ──────────────────────────────── */
.pers-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px}
.pers-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px}
.pers-head{display:flex;gap:12px;align-items:flex-start;margin-bottom:14px}
.pers-head .ico{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.pers-head h3{font-size:15.5px;font-weight:700}
.pers-head small{display:block;font-size:12.5px;color:var(--ink-soft);font-weight:500}
.pers-card ul{list-style:none;margin-bottom:14px}
.pers-card li{font-size:13.5px;color:var(--ink);padding-left:16px;position:relative;margin-bottom:8px}
.pers-card li::before{content:"";width:6px;height:6px;border-radius:99px;position:absolute;left:0;top:7px}
.pers-card.c-lavande li::before{background:var(--lavande-full)}
.pers-card.c-menthe li::before{background:var(--menthe-full)}
.pers-card.c-rose li::before{background:var(--rose-full)}
.pers-card.c-peche li::before{background:var(--peche-full)}
.pers-card .ico.c-lavande{background:var(--lavande-bg);color:var(--lavande-tx)}
.pers-card .ico.c-menthe{background:var(--menthe-bg);color:var(--menthe-tx)}
.pers-card .ico.c-rose{background:var(--rose-bg);color:var(--rose-tx)}
.pers-card .ico.c-peche{background:var(--peche-bg);color:var(--peche-tx)}
.pers-foot{border-top:1px solid var(--line);padding-top:12px}
.pers-foot small{display:block;font-size:10.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px}
.pers-foot .tags{display:flex;flex-wrap:wrap;gap:6px}

/* ── Architecture data (pyramide) ────────────────────── */
.pyramid{display:flex;flex-direction:column;align-items:center;gap:10px}
.pyr-layer{border-radius:12px;padding:16px 24px;text-align:center;border:1px solid}
.pyr-layer h3{font-size:14.5px;font-weight:700;margin-bottom:3px}
.pyr-layer p{font-size:12.5px}
.pyr-layer.l1{width:min(46%,420px);background:var(--corail-bg);border-color:var(--corail-bd)} .pyr-layer.l1 p{color:var(--corail-tx)}
.pyr-layer.l2{width:min(70%,640px);background:var(--lavande-bg);border-color:var(--lavande-bd)} .pyr-layer.l2 p{color:var(--lavande-tx)}
.pyr-layer.l3{width:min(94%,860px);background:var(--bleu-bg);border-color:var(--bleu-bd)}     .pyr-layer.l3 p{color:var(--bleu-tx)}

/* ── Funnel ──────────────────────────────────────────── */
.funnel-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px}
.funnel-card{border-radius:14px;padding:20px;border:1px solid}
.funnel-card small{display:block;font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px}
.funnel-card h3{font-size:16px;font-weight:700;margin-bottom:10px}
.funnel-card p{font-size:13px;line-height:1.6}
.funnel-card.c-lavande{background:var(--lavande-bg);border-color:var(--lavande-bd)} .funnel-card.c-lavande small,.funnel-card.c-lavande p{color:var(--lavande-tx)}
.funnel-card.c-menthe{background:var(--menthe-bg);border-color:var(--menthe-bd)}    .funnel-card.c-menthe small,.funnel-card.c-menthe p{color:var(--menthe-tx)}
.funnel-card.c-corail{background:var(--corail-bg);border-color:var(--corail-bd)}    .funnel-card.c-corail small,.funnel-card.c-corail p{color:var(--corail-tx)}

/* ── RGPD / Brand safety ─────────────────────────────── */
.rgpd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px}
.rgpd-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px}
.rgpd-card h3{font-size:15px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.rgpd-card ul{list-style:none}
.rgpd-card li{font-size:13.5px;padding-left:16px;position:relative;margin-bottom:9px;color:var(--ink)}
.rgpd-card li::before{content:"";width:6px;height:6px;border-radius:99px;background:var(--royal);position:absolute;left:0;top:7px}

/* ── Footer contacts (charte kit média) ──────────────── */
footer{background:var(--royal);color:#fff;padding:52px 0 56px;margin-top:0}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:32px;align-items:flex-start}
footer .contacts{display:flex;gap:44px;flex-wrap:wrap}
footer .contact b{font-family:'Poppins';font-size:16px;font-weight:700;display:block;margin-bottom:3px}
footer .contact span{display:block;font-size:12.5px;color:#DCE6FF;line-height:1.6}
footer .contact a{color:#fff;text-decoration:underline;text-underline-offset:2px}
footer .legal{width:100%;margin-top:26px;padding-top:18px;border-top:1px solid rgba(255,255,255,.25);font-size:11.5px;color:#C7D4FF}
footer .tgw-logo{margin-bottom:0}

@media (max-width:640px){
  .wrap{padding:0 20px}
  header.hero{padding:40px 0 36px}
  section{padding:40px 0}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>

<nav class="toc" aria-label="Sections">
  <div class="wrap">
